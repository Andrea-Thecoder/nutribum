{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NutriBum",
  "version": "0.4.0",
  "identifier": "it.nutrition.nutribum",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NutriBum",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 480,
        "height": 680,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "copyright": "Copyright © 2026 Andrea Leone",
    "shortDescription": "Traccia calorie, macronutrienti e peso corporeo",
    "longDescription": "NutriBum aiuta a tenere sotto controllo l'alimentazione quotidiana: catalogo alimenti, ricette, diario dei pasti, obiettivi personalizzati di calorie e macronutrienti, monitoraggio del peso corporeo e report grafici. Tutti i dati restano sul computer, nessun account o connessione a internet richiesti.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/campione-alimenti.json"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4RENCNTE1OEVGODNCNEYKUldSUE8vaU9GYlhjaU10bGNUZmpVQi9sanFvSmJhV1hkQ05Fck5qcnRtT1dkNHkvc1R5Mkhjd2EK",
      "endpoints": [
        "https://github.com/Andrea-Thecoder/nutribum/releases/latest/download/latest.json"
      ]
    }
  }
}
